DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:backend|database|docs|registry)(?:/|$) - [F,L]
</IfModule>

<FilesMatch "^(?:\.htaccess|module\.json|SHA256SUMS\.txt|README\.md|CHANGELOG\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
