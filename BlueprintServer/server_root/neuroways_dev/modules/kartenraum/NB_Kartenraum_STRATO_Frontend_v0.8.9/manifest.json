{
  "module": "nb_kartenraum",
  "version": "0.8.9",
  "based_on": "NB_Kartenraum_STRATO_Frontend_v0.6.1",
  "backend": "../NB_Kartenraum_Backend_v0.6.3/api",
  "visual_reference": "https://neurobalance-kartenraum.neuroways.chatgpt.site/",
  "features": {
    "neuroways_hierarchy": true,
    "public_landing": true,
    "tarot_intro": true,
    "personal_home": true,
    "single_click_draw": true,
    "reversed_cards": true,
    "perception_first": true,
    "three_depth_knowledge": true,
    "physical_card_viewer": true,
    "journal_existing_api": true,
    "responsive": true
  },
  "prepared_not_active": [
    "connections",
    "decks",
    "favorites"
  ],
  "test_login": {
    "visible_on_login": true,
    "audience": "ADULT",
    "username": "Test_E",
    "quick_fill": true
  },
  "viewport_draw_layout": {
    "card_and_draw_button_without_scroll": true,
    "uses_dynamic_viewport_height": true,
    "responsive_to_short_screens": true
  },
  "draw_interaction": {
    "card_itself_is_primary_control": true,
    "touch_press_feedback": true,
    "touch_ripple": true,
    "lift_before_reveal": true,
    "keyboard_accessible": true
  },
  "review_and_journal": {
    "review": "latest draw only",
    "journal": "chronological collection"
  },
  "living_journal": {
    "per_draw": true,
    "first_perception_preserved": true,
    "later_entries_multiple": true,
    "book_overlay": true,
    "current_persistence": "MariaDB via Backend v0.6.0",
    "api_list": "experience-list.php",
    "api_save": "experience-save.php",
    "cross_device": true
  },
  "home_primary_action": {
    "draw_card": "single prominent action",
    "duplicate_room_tile_removed": true
  },
  "depth_journal": {
    "enabled": true,
    "entry_types": [
      "THOUGHT",
      "INSIGHT",
      "QUESTION",
      "GOAL"
    ],
    "depth_codes": [
      "QUESTION",
      "MOMENT",
      "MEANING",
      "SYMBOLISM",
      "OTHER_DIRECTION"
    ],
    "no_page_change": true
  },
  "data_ownership": {
    "journal_edit": true,
    "journal_delete": true,
    "logout_visible": true,
    "logout_server_revoke": true,
    "local_session_clear": true
  },
  "brand": {
    "world": "NeuroWays",
    "land": "NeuroBalance",
    "room": "Room of Cards"
  },
  "profile_preferences": {
    "card_audience_code": [
      "CHILD",
      "ADULT"
    ],
    "ui_language_mode": [
      "CLEAR",
      "DETAILED"
    ],
    "visual_mode": [
      "WONDER",
      "NIGHT"
    ],
    "independent": true
  },
  "visual_rebuild": {
    "original_cat_image": true,
    "public_start_rebuilt": true,
    "private_home_rebuilt": true,
    "night_magic": true,
    "wonder_magic": true
  },
  "profile_settings_ui": {
    "controller": "profile-settings.js",
    "isolated_from_app_js": true,
    "session_source": "localStorage nb_kartenraum_frontend_v070.session_token",
    "backend": "NB_Kartenraum_Backend_v0.6.3",
    "endpoint": "profile-preferences.php"
  },
  "journal_card_popup": {
    "enabled": true,
    "preserves_draw_orientation": true,
    "reversed_rendering": "rotate-180",
    "page_change": false
  },
  "shared_draw_detail_viewer": {
    "journal": true,
    "last_encounter": true,
    "depths": [
      "SHORT",
      "MORE",
      "DEEP"
    ],
    "orientation_preserved": true
  }
}