# NeuroQuest Environment Variables
# This file is for reference only. Do NOT commit real secrets.

# PocketBase Configuration
# Dev: /.sfs-bd/ | Production: /.sfs-be/
VITE_POCKETBASE_URL=http://localhost:8090

# App Configuration
VITE_APP_NAME=NeuroQuest
VITE_APP_LANGUAGE=de
VITE_APP_VERSION=1.0.0

# GitHub Token (NOT to be stored here – use git credential store)
# Example for reference:
# GITHUB_TOKEN=github_pat_1...

# Build Mode
# Options: "preview" (/.sfs-preview/) | "prod" (/.sfs/)
# Set via npm run build | npm run build:prod
NODE_ENV=production
