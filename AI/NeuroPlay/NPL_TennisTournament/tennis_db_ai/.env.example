# PocketBase Configuration
# These are PUBLIC configuration examples - not secrets

# Development PocketBase Base URL
# (Actual URL will be determined at runtime based on environment)
VITE_PB_BASE_DEV=/.sfs-bd/

# Production PocketBase Base URL
VITE_PB_BASE_PROD=/.sfs-be/

# Application Environment
VITE_APP_ENV=development

# Admin Login Credentials (FOR LOCAL DEVELOPMENT ONLY)
# NEVER commit real credentials
# Use the PocketBase Admin Panel to create accounts
VITE_ADMIN_EMAIL=admin@example.local
# VITE_ADMIN_PASSWORD=never_commit_this

# Pagination Defaults
VITE_PAGE_SIZE=50

# Feature Flags (optional)
VITE_ENABLE_SCHEDULE_AI=false
VITE_ENABLE_LIVE_UPDATES=false

# GitHub Repository (for documentation/backup)
VITE_GITHUB_REPO=organisation/tennis_db_ai
