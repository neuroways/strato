    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "comp_02",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Padding: Großzügig — lieber zu viel Luft als zu wenig.",
