    "code": "DESIGN_RULE_ILL_07",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.756Z",
    "id": "grvs1jpy3xpml3j",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "ill_07",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Kein Text innerhalb von Illustrationen. Keine Beschriftungen, Pfeile oder Symbole.",
    "sort_order": 160,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "kzltjgkbsvqskci",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.756Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_ILL_06",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.754Z",
    "id": "1dcws70etucv0px",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "ill_06",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Keine Tiere. Keine Vögel. Niemals.",
    "sort_order": 150,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "qdg2qnmnw5pbkde",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.754Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_ILL_05",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.752Z",
    "id": "9ookcsqlvmaae29",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "ill_05",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Keine Personen. Keine Silhouetten. Keine Spuren. Niemals.",
    "sort_order": 140,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "7rygafw7j9ds954",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.752Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_ILL_04",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.750Z",
    "id": "yo8d3ykamt355nw",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "ill_04",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Licht: Diffus, weich, ohne Richtung. Die Welt leuchtet von innen. Keine Schatten mit harten Kanten.",
    "sort_order": 130,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "pffzz1pgl1mhdsw",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.750Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_ILL_03",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.748Z",
    "id": "zlxkwbqz15zre39",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "ill_03",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Perspektive: Leicht erhöhte Augenhöhe. Horizont immer sichtbar, immer im oberen Drittel.",
    "sort_order": 120,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "er17e3ghhbtveqt",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.748Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_ILL_02",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.746Z",
    "id": "ocbe5wwf5rxdu1l",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "ill_02",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Format Zonenbilder: 800 × 480 px (Querformat).",
    "sort_order": 110,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "i71a8eq48elws91",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.746Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_ILL_01",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.744Z",
    "id": "sw6q5a2jbanhv9d",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "ill_01",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Stil: Flache Vektorgrafik mit organischen Formen. Keine Outlines. Weiche Übergänge zwischen Farbflächen. Leichte Papier- oder Leinentextur als Overlay (max. 8% Deckkraft).",
    "sort_order": 100,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "7nch8u4buz5rvze",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.744Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_MOV_08",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.743Z",
    "id": "lea84iunxe6myv3",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "mov_08",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Neue Regionen entstehen am Rand der bestehenden Welt. Sie verändern bestehende Regionen nicht.",
    "sort_order": 80,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "prbtytlvogz4yij",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.743Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_MOV_07",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.741Z",
    "id": "ivcekfzwxso2whs",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "mov_07",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Kein Rückweg ist ein Rückschritt. Zurück zum Festland ist genauso wertvoll wie vorwärts.",
    "sort_order": 70,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "v92jrjtd30tbxx5",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.741Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_MOV_06",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.739Z",
    "id": "gv9flta246xa3ik",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "mov_06",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Die Insel ist ein Ort des Schutzes, nicht der Isolation. Sie ist erreichbar und verlassbar.",
    "sort_order": 60,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "sq8lt2jf3uydp4w",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.739Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_MOV_05",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.737Z",
    "id": "smugi74ab4gpx32",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "mov_05",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Die Küste ist der natürliche Wendepunkt. Von hier aus kann man in beide Richtungen.",
    "sort_order": 50,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "6cx580tcao9ddsb",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.737Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_MOV_04",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.735Z",
    "id": "bpv803nmdb9a49j",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "mov_04",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Das Wasser verbindet alle Regionen. Es ist das navigierbare Element der Welt.",
    "sort_order": 40,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "j2fg4kosdfa7alh",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.735Z",
    "version": "1.0.0"
  },
  {
    "accessibility_note": "",
    "audio_asset_ref": "",
    "code": "DESIGN_RULE_MOV_03",
    "collectionId": "pbc_3778343311",
    "collectionName": "nwo_content",
    "content_type": "TEXT",
    "created": "2026-07-24 08:29:38.729Z",
    "id": "ppb4974wbg18zs6",
    "locale": "de",
    "migration_version": "MIG-001-P2",
    "object_type": "CONTENT",
    "parent_code": "mov_03",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Bewegung ist immer möglich. Kein Zustand ist endgültig.",
    "sort_order": 30,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "jggfa4qok9m8k7g",
    "status": "PUBLISHED",
    "updated": "2026-07-24 08:29:38.729Z",
    "version": "1.0.0"
  }
