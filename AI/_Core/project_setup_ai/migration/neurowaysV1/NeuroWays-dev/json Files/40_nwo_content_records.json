    "object_type": "CONTENT",
    "parent_code": "comp_01",
    "parent_object_type": "DESIGN_RULE",
    "primary_text": "Radius: 16–24 px (organisch, nie hart).",
    "sort_order": 200,
    "source_collection": "design_rules",
    "source_field": "rule_text",
    "source_id": "7lfvuo0dzffl6hj",
    "status": "PUBLISHED",
