    "id": "kzltjgkbsvqskci",
    "is_prohibited": true,
    "rule_code": "ill_07",
    "rule_text": "Kein Text innerhalb von Illustrationen. Keine Beschriftungen, Pfeile oder Symbole.",
    "section_number": "8.2",
    "section_title": "Illustration",
    "sort_order": 160,
    "updated": "2026-07-23 17:29:44.703Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "illustration",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.676Z",
    "id": "qdg2qnmnw5pbkde",
    "is_prohibited": true,
    "rule_code": "ill_06",
    "rule_text": "Keine Tiere. Keine Vögel. Niemals.",
    "section_number": "8.2",
    "section_title": "Illustration",
    "sort_order": 150,
    "updated": "2026-07-23 17:29:44.676Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "illustration",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.649Z",
    "id": "7rygafw7j9ds954",
    "is_prohibited": true,
    "rule_code": "ill_05",
    "rule_text": "Keine Personen. Keine Silhouetten. Keine Spuren. Niemals.",
    "section_number": "8.2",
    "section_title": "Illustration",
    "sort_order": 140,
    "updated": "2026-07-23 17:29:44.649Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "illustration",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.622Z",
    "id": "pffzz1pgl1mhdsw",
    "is_prohibited": false,
    "rule_code": "ill_04",
    "rule_text": "Licht: Diffus, weich, ohne Richtung. Die Welt leuchtet von innen. Keine Schatten mit harten Kanten.",
    "section_number": "8.2",
    "section_title": "Illustration",
    "sort_order": 130,
    "updated": "2026-07-23 17:29:44.622Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "illustration",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.596Z",
    "id": "er17e3ghhbtveqt",
    "is_prohibited": false,
    "rule_code": "ill_03",
    "rule_text": "Perspektive: Leicht erhöhte Augenhöhe. Horizont immer sichtbar, immer im oberen Drittel.",
    "section_number": "8.2",
    "section_title": "Illustration",
    "sort_order": 120,
    "updated": "2026-07-23 17:29:44.596Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "illustration",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.569Z",
    "id": "i71a8eq48elws91",
    "is_prohibited": false,
    "rule_code": "ill_02",
    "rule_text": "Format Zonenbilder: 800 × 480 px (Querformat).",
    "section_number": "8.2",
    "section_title": "Illustration",
    "sort_order": 110,
    "updated": "2026-07-23 17:29:44.569Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "illustration",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.543Z",
    "id": "7nch8u4buz5rvze",
    "is_prohibited": false,
    "rule_code": "ill_01",
    "rule_text": "Stil: Flache Vektorgrafik mit organischen Formen. Keine Outlines. Weiche Übergänge zwischen Farbflächen. Leichte Papier- oder Leinentextur als Overlay (max. 8% Deckkraft).",
    "section_number": "8.2",
    "section_title": "Illustration",
    "sort_order": 100,
    "updated": "2026-07-23 17:29:44.543Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "movement",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.516Z",
    "id": "prbtytlvogz4yij",
    "is_prohibited": false,
    "rule_code": "mov_08",
    "rule_text": "Neue Regionen entstehen am Rand der bestehenden Welt. Sie verändern bestehende Regionen nicht.",
    "section_number": "5",
    "section_title": "Bewegungsregeln",
    "sort_order": 80,
    "updated": "2026-07-23 17:29:44.516Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "movement",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.489Z",
    "id": "v92jrjtd30tbxx5",
    "is_prohibited": false,
    "rule_code": "mov_07",
    "rule_text": "Kein Rückweg ist ein Rückschritt. Zurück zum Festland ist genauso wertvoll wie vorwärts.",
    "section_number": "5",
    "section_title": "Bewegungsregeln",
    "sort_order": 70,
    "updated": "2026-07-23 17:29:44.489Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "movement",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.461Z",
    "id": "sq8lt2jf3uydp4w",
    "is_prohibited": false,
    "rule_code": "mov_06",
    "rule_text": "Die Insel ist ein Ort des Schutzes, nicht der Isolation. Sie ist erreichbar und verlassbar.",
    "section_number": "5",
    "section_title": "Bewegungsregeln",
    "sort_order": 60,
    "updated": "2026-07-23 17:29:44.461Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "movement",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.435Z",
    "id": "6cx580tcao9ddsb",
    "is_prohibited": false,
    "rule_code": "mov_05",
    "rule_text": "Die Küste ist der natürliche Wendepunkt. Von hier aus kann man in beide Richtungen.",
    "section_number": "5",
    "section_title": "Bewegungsregeln",
    "sort_order": 50,
    "updated": "2026-07-23 17:29:44.435Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "movement",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.409Z",
    "id": "j2fg4kosdfa7alh",
    "is_prohibited": false,
    "rule_code": "mov_04",
    "rule_text": "Das Wasser verbindet alle Regionen. Es ist das navigierbare Element der Welt.",
    "section_number": "5",
    "section_title": "Bewegungsregeln",
    "sort_order": 40,
    "updated": "2026-07-23 17:29:44.409Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "movement",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.383Z",
    "id": "jggfa4qok9m8k7g",
    "is_prohibited": false,
    "rule_code": "mov_03",
    "rule_text": "Bewegung ist immer möglich. Kein Zustand ist endgültig.",
    "section_number": "5",
    "section_title": "Bewegungsregeln",
    "sort_order": 30,
    "updated": "2026-07-23 17:29:44.383Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "movement",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.357Z",
    "id": "zxi8wbevwhigcbp",
    "is_prohibited": false,
    "rule_code": "mov_02",
    "rule_text": "Jede Region besitzt sichtbare Übergänge. Man sieht, wohin der Weg führt.",
    "section_number": "5",
    "section_title": "Bewegungsregeln",
    "sort_order": 20,
    "updated": "2026-07-23 17:29:44.357Z",
    "world_version_id": "3hbx5gsy932l77e"
  },
  {
    "category": "movement",
    "collectionId": "pbc_2028186649",
    "collectionName": "design_rules",
    "created": "2026-07-23 17:29:44.325Z",
    "id": "1tn284y0d1j179i",
    "is_prohibited": false,
    "rule_code": "mov_01",
    "rule_text": "Alle Regionen sind miteinander verbunden. Es gibt keine Sackgassen.",
    "section_number": "5",
    "section_title": "Bewegungsregeln",
    "sort_order": 10,
    "updated": "2026-07-23 17:29:44.325Z",
    "world_version_id": "3hbx5gsy932l77e"
  }
