# NeuroWays Environment Configuration
# Kopiere diese Datei nach .env und fülle die Werte aus

# Datenbankverbindung (nicht konfiguriert)
# Wird nach Datenbank-Entscheidung in PHASE 1 definiert
# DATABASE_URL=

# Authentifizierung (nicht implementiert)
# Wird nach Auth-System-Entscheidung definiert
# AUTH_SECRET=
# SESSION_TIMEOUT_MINUTES=30

# API (nicht implementiert)
# API_BASE_URL=http://localhost:3000

# Deployment
# NODE_ENV=production
# VITE_API_URL=https://api.neuroways.local

# Hinweis: Keine echten Secrets in diese Datei!
# Verwende lokale Environment Variables oder einen Secret Manager für Produktionswerte.
